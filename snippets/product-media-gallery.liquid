{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'
  Also see 'product-media-modal'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - limit: {Number} (optional) When passed, limits the number of media items to render

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{%- liquid
  if section.settings.hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif

  if limit == 1
    assign single_media_visible = true
  endif

  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  if media_count == 1 or single_media_visible
    assign single_media_visible_mobile = true
  endif

  if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails == 'show' or section.settings.mobile_thumbnails == 'columns' and media_count < 3
    assign hide_mobile_slider = true
  endif

  if section.settings.media_size == 'large'
    assign media_width = 0.65
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.55
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif
-%}
<style>
   .product-media-gallery {
   display: flex;
   width: 100%;
   position: relative;
   }
   .gallery-container {
   display: flex;
   width: 100%;
   }
   .thumbnails-column {
   display: flex;
   flex-direction: column;
   margin-right: 15px;
   height: 584px;
   overflow: auto;
   }
   .thumbnails-column::-webkit-scrollbar {
   display: none;
   }
   .thumbnail-item {
   width: 105px;
   height: 105px;
   margin-bottom: 10px;
   display: flex;
   align-items: center;
   justify-content: center;
   cursor: pointer;
   }
   .thumbnail-item.active {
     border:  0.75px solid rgba(188, 34, 39, 1);
    }
    .thumbnail-image {
      width: 100%;
      height: 100px;
      object-fit: contain;
      background: #fff;
    }
    .main-image-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 468px;
      height: 584px;
      position: relative;
      padding-top: 0px;
      padding-bottom: 0px;
      padding-right: 0px;
      padding-left: 0px;
      border: 0px;
      background: none;
      cursor: pointer;
    }
    .main-product-image {
      height: 100%;
      width: 100%;
      object-fit: contain;
      background-color: #fff;
    }
    /* Magnify button styles */
    .magnify-button {
      position: absolute;
      bottom: 15px;
      right: 15px;
      background-color: rgba(255, 255, 255, 0.8);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border: none;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      z-index: 2;
      transition: all 0.2s ease;
    }
    .magnify-button:hover {
      background-color: rgba(255, 255, 255, 1);
      transform: scale(1.05);
    }
    /* Modal styles */
    .image-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.9);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal-content {
      position: relative;
      max-width: 95%;
      max-height: 95%;
      margin: auto;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .modal-image {
      max-width: 100%;
      max-height: 90vh;
      object-fit: contain;
    }
    .close-modal {
      position: absolute;
      top: 20px;
      right: 30px;
      color: #fff;
      font-size: 30px;
      font-weight: bold;
      cursor: pointer;
      z-index: 1001;
    }
    .nav-button {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background-color: rgba(255, 255, 255, 0.5);
      border: none;
      color: #000;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      z-index: 1001;
    }
    .nav-button:hover {
      background-color: rgba(255, 255, 255, 0.8);
    }
    .prev-button {
      left: 30px;
    }
    .next-button {
      right: 30px;
    }
    .image-counter {
      position: absolute;
      top: 20px;
      left: -50%;
      right: -50%;
      color: #fff;
      font-size: 16px;
      z-index: 1001;
      padding: 5px 10px;
      border-radius: 4px;
      width: 70px;
      align-items: center;
      justify-content: center;
      display: flex;
      margin: 0 auto;
    }
    /* Mobile styles */
    @media screen and (max-width: 1024px) {
      .gallery-container {
        flex-direction: column-reverse;
      }
      .thumbnails-column {
        flex-direction: row;
        width: 100%;
        margin-right: 0;
        margin-top: 15px;
        overflow-x: auto;
        height: unset;
        gap:10px;
        margin-bottom: 1.5rem;
      }
      .thumbnail-item {
        width: 80px;
        height: 80px;
        margin-bottom: 0;
      }
      .thumbnail-item.active {
        padding: 42px;
      }
   .thumbnail-image {
   width: 80px;
   height: 80px;
   object-fit: contain;
   background: #fff;
   }
   .main-image-container {
   width: 100%;
   height: auto;
   aspect-ratio: 1/1;
   margin-bottom: 10px;
   object-fit: contain;
   background: #fff;
   }
   .nav-button {
   width: 40px;
   height: 40px;
   }
   .prev-button {
   left: 10px;
   }
   .next-button {
   right: 10px;
   }
   .image-modal .modal-content {
   flex-direction: column;
   }
   .image-modal .nav-buttons-container {
   display: flex;
   justify-content: center;
   gap: 20px;
   margin-top: 20px;
   }
   .image-modal .nav-button {
   position: static;
   transform: none;
   width: 40px;
   height: 40px;
   background-color: rgba(255, 255, 255, 0.8);
   }
   }
</style>
<script>
   document.addEventListener('DOMContentLoaded', function() {
     let currentImageIndex = 0;
     const galleryImages = [];
     
     // Collect all gallery images and their high-resolution versions
     document.querySelectorAll('.thumbnail-item').forEach((thumbnail, index) => {
       // Get the regular size image URL
       const imageUrl = thumbnail.getAttribute('data-image-url');
       
       // Create high-resolution image URL by replacing 'large' with 'master'
       // 'master' is typically the highest quality in Shopify
       const highResImageUrl = imageUrl ? imageUrl.replace('_large', '') : null;
       
       const imageAlt = thumbnail.querySelector('.thumbnail-image').alt;
       galleryImages.push({
         url: imageUrl,
         highResUrl: highResImageUrl || imageUrl, // Fallback to regular URL if high res not available
         alt: imageAlt
       });
     });
     
     function switchMainImage(thumbnailElement) {
       // Remove active class from all thumbnails
       const thumbnails = document.querySelectorAll('.thumbnail-item');
       thumbnails.forEach((thumb, index) => {
         if (thumb === thumbnailElement) {
           currentImageIndex = index;
         }
         thumb.classList.remove('active');
       });
       
       // Add active class to clicked thumbnail
       thumbnailElement.classList.add('active');
       
       // Update main image
       const mainImage = document.getElementById('main-product-image');
       const newImageUrl = thumbnailElement.getAttribute('data-image-url');
       if (newImageUrl) {
         mainImage.src = newImageUrl;
         mainImage.alt = thumbnailElement.querySelector('img').alt;
       }
     }
     
     // Make the switchMainImage function global
     window.switchMainImage = switchMainImage;
     
     // Add modal to the page
     const modal = document.createElement('div');
     modal.className = 'image-modal';
     modal.innerHTML = `
   <span class="close-modal">&times;</span>
   <div class="image-counter">
     <span id="current-image">1</span> / <span id="total-images">1</span>
   </div>
   <div class="modal-content">
     <img class="modal-image" src="" alt="">
     <div class="nav-buttons-container">
       <button class="nav-button prev-button">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M15 18L9 12L15 6" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
         </svg>
       </button>
       <button class="nav-button next-button">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M9 18L15 12L9 6" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
         </svg>
       </button>
     </div>
   </div>
   `;
     document.body.appendChild(modal);
     
     // Add magnify button to main image container
     const mainImageContainer = document.querySelector('.main-image-container');
     const magnifyButton = document.createElement('button');
     magnifyButton.className = 'magnify-button';
     magnifyButton.innerHTML = `
       <svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
         <path d="M8.5 3a5.5 5.5 0 014.235 9.019l4.972 4.974a1 1 0 01-1.414 1.414l-4.974-4.972A5.5 5.5 0 118.5 3zm0 2a3.5 3.5 0 100 7 3.5 3.5 0 000-7z" fill="#000" fill-rule="nonzero"/>
       </svg>
     `;
     mainImageContainer.appendChild(magnifyButton);
     
     // Magnify button click handler
     magnifyButton.addEventListener('click', function(e) {
       e.stopPropagation();
       openModal();
     });
     
     // Main image container click handler
     mainImageContainer.addEventListener('click', function() {
       openModal();
     });
     
     // Close button handler
     modal.querySelector('.close-modal').addEventListener('click', closeModal);
     
     // Navigation button handlers
     modal.querySelector('.prev-button').addEventListener('click', function(e) {
       e.stopPropagation();
       showPrevImage();
     });
     
     modal.querySelector('.next-button').addEventListener('click', function(e) {
       e.stopPropagation();
       showNextImage();
     });
     
     // Close modal when clicking outside content
     modal.addEventListener('click', function(event) {
       if (event.target === modal) {
         closeModal();
       }
     });
     
     // Prevent image click from closing modal
     modal.querySelector('.modal-image').addEventListener('click', function(e) {
       e.stopPropagation();
     });
     
     // Keyboard navigation
     document.addEventListener('keydown', function(event) {
       if (!modal.style.display || modal.style.display === 'none') return;
       
       if (event.key === 'Escape') {
         closeModal();
       } else if (event.key === 'ArrowLeft') {
         showPrevImage();
       } else if (event.key === 'ArrowRight') {
         showNextImage();
       }
     });
     
     function openModal() {
       modal.style.display = 'flex';
       document.body.style.overflow = 'hidden'; // Prevent scrolling
       showModalImage(currentImageIndex);
     }
     
     function closeModal() {
       modal.style.display = 'none';
       document.body.style.overflow = '';
     }
     
     // Replace the existing showModalImage function with:
   function showModalImage(index) {
   if (index < 0) index = galleryImages.length - 1;
   if (index >= galleryImages.length) index = 0;
   
   currentImageIndex = index;
   
   const modalImage = modal.querySelector('.modal-image');
   
   // Update image counter
   modal.querySelector('#current-image').textContent = currentImageIndex + 1;
   modal.querySelector('#total-images').textContent = galleryImages.length;
   
   // Use the high-resolution image URL for the modal
   modalImage.src = galleryImages[index].highResUrl;
   modalImage.alt = galleryImages[index].alt;
   
   // Preload adjacent images for smoother navigation
   if (galleryImages[index + 1]) {
     const nextImage = new Image();
     nextImage.src = galleryImages[index + 1].highResUrl;
   }
   
   if (galleryImages[index - 1]) {
     const prevImage = new Image();
     prevImage.src = galleryImages[index - 1].highResUrl;
   }
   }
     
     function showPrevImage() {
       showModalImage(currentImageIndex - 1);
     }
     
     function showNextImage() {
       showModalImage(currentImageIndex + 1);
     }
   });
</script>
<media-gallery
id="MediaGallery-{{ section.id }}"
role="region"
{% if section.settings.enable_sticky_info %}
class="product__column-sticky"
{% endif %}
aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
data-desktop-layout="{{ section.settings.gallery_layout }}"
>
<div class="product-media-gallery">
   <div class="gallery-container">
      <!-- Vertical thumbnails on the left (desktop) / Horizontal thumbnails on bottom (mobile) -->
      <div class="thumbnails-column">
         {% for media in product.media %}
         <div class="thumbnail-item{% if forloop.first %} active{% endif %}" 
         data-media-id="{{ media.id }}"
         {% if media.media_type == 'image' %}
         data-image-url="{{ media.src | img_url: 'large' }}"
         {% endif %}
         onclick="switchMainImage(this)">
         <img src="{{ media.preview_image | img_url: 'large'  }}" alt="{{ media.alt | escape }}" class="thumbnail-image">
      </div>
      {% endfor %}
   </div>
   <!-- Main product image on the right (desktop) / top (mobile) -->
   <button class="main-image-container">
      {% if product.featured_media %}
      <img id="main-product-image" 
         src="{{ product.featured_media | img_url: 'large' }}" 
         alt="{{ product.featured_media.alt | escape }}" 
         class="main-product-image">
      {% endif %}
      <!-- Magnify button will be added here via JavaScript -->
   </button>
</div>
</div>
</media-gallery>